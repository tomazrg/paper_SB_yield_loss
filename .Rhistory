b1_sim <- runif(400,min = 159.97, max = 796.82)
sim_df <- expand_grid(
S = S_seq,
b0 = b0_sim,
b1 = b1_sim
) %>%
mutate(
Y  = b0 + b1 * S,
Y0 = b0
)
tradeoff_df <- sim_df %>%
mutate(
B0 = b0,
DC = -b1 / b0,
B1 = -b1
)
tradeoff_df %>%
ggplot(aes(B0,DC, color = B1))+
geom_jitter()+
geom_smooth(se = F, color = NA)+
theme_bw()+
scale_colour_stepsn(
colours = c("#2E8B57",   # dark brown
"#7FBF7B",   # medium brown
"#D1BE91",   # beige transition
"#A6764D",   # light green
"#6F3F1F"),  # dark green
n.breaks = 6,             # number of steps (adjust for contrast)
name = "Slope",
guide = guide_legend(
override.aes = list(size = 6)
))+
labs(x = "Attainable yield (ton/ha)",
y = "Damage coefficient (%/p.p)")+
theme_bw()+
theme(
legend.position = "right",
text = element_text(size = 14),
legend.justification = "center",

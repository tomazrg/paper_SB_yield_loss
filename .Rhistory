camila = gsheet2tbl("https://docs.google.com/spreadsheets/d/1zX-6_nGgKGZH8DBTxBpnoYX_xzM0cINBViJLXkK5hV4/edit?usp=sharing")
data2
data2$plot_moist = data2$plot_moist/100
data2$plot_weight = data2$plot_weight/100
#data2$SB = data2$SB*10
data22 = data2 %>%
filter(!is.na(SB)) %>%
filter(!is.na(yield_lb)) %>%
dplyr::mutate(
trt = factor(trt),
# weig_12 = tw*((100 - plot_moist)/88),
yld = plot_weight/(80/43560),
kg_ha = yld*1.2085) %>%
filter(!kg_ha <=4000)
data22$year = as.factor(data22$year)
data22$blk = as.factor(data22$blk)
data22$trial = as.factor(data22$trial)
data222 = data22  %>%
#filter(!year == "2025") %>%
#filter(!trial %in% c("25-P2S1_VAR2","25-P2S2_PC2")) %>%
# filter(!is.na(SB_1)) %>%
select(year,trial,gen,trt,plot,blk,SB,kg_ha)
camila$kg_ha = camila$kg_ha*1000
camila$SB = camila$SB/100
camila = camila %>%
select(year,trial,gen,trt,plot,blk,SB,kg_ha)
camila$year = as.factor(camila$year)
camila$blk = as.factor(camila$blk)
camila$trial = as.factor(camila$trial)
data222 = rbind(camila,data222)
data222
library(lme4)
tt <- lmer(
kg_ha ~ SB +
(1 + SB | gen) +
(1|trial/blk), data = data222)
re <- ranef(tt)$gen
damage_coef <- data.frame(
gen = rownames(re),
intercept = fixef(tt)[1] + re[, "(Intercept)"],
damage_coef = fixef(tt)["SB"] + re[, "SB"]
)
set.seed(123)
damage_coef2 = damage_coef %>%
select(damage_coef,gen)
damage_coef2 = damage_coef2 %>%
filter(!damage_coef >= 0)
dados_dummy <- model.matrix(~ gen - 1, data = damage_coef2)
set.seed(123)
dados_preparados <- cbind(dados_dummy, DC = damage_coef2$damage_coef)
set.seed(123)
resultado_kmeans <- kmeans(dados_preparados, centers = 3)
library(factoextra)
p = fviz_cluster(resultado_kmeans, data = dados_preparados, label = NULL,geom = "point",pointsize = 3, shape = 20)
p2 = p +
scale_color_manual(values = c('#9ccb86','#cf597e','steelblue'))+
scale_fill_manual(values = c('#9ccb86','#cf597e','steelblue'))+
theme(
axis.title = element_text(size = 14, face = "bold"),
axis.text = element_text(size = 12)) +
labs(
title = "",
x = "PC1",
y = "PC2")+
theme(legend.position = "none")
p2

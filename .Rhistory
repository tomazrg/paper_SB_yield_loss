library(dplyr)
library(ggplot2)
tradeoff_df2 <- tradeoff_df %>%
mutate(
B1_class = cut(
B1,
breaks = c(-800, -725, -675, -625, -575),
labels = c("-750", "-700", "-650", "-600"),
include.lowest = TRUE
)
)
area_df <- tradeoff_df2 %>%
mutate(
B0_bin = cut(B0, breaks = 100)
) %>%
group_by(B1_class, B0_bin) %>%
summarise(
B0_mid = mean(B0),
DC_low = quantile(DC, 0.05),
DC_high = quantile(DC, 0.95),
.groups = "drop"
)
ggplot(area_df,
aes(x = B0_mid,
ymin = DC_low,
ymax = DC_high,
fill = B1_class)) +
geom_ribbon(alpha = 0.85, color = NA) +
scale_fill_manual(
values = c(
"-750" = "#2E8B57",
"-700" = "#7FBF7B",
"-650" = "#D1BE91",
"-600" = "#A6764D"
),
name = "Slope (B1)"
) +
labs(
x = "Attainable yield (kg/ha)",
y = "Damage coefficient (%/p.p)"
) +
theme_bw() +
theme(
legend.position = "right",
text = element_text(size = 14),
axis.title = element_text(size = 18, face = "bold")
)
ggplot(area_df, aes(B0_mid, fill = B1_class)) +
geom_ribbon(aes(ymin = DC_low, ymax = DC_high), alpha = 0.7) +
geom_line(
aes(y = (DC_low + DC_high) / 2, color = B1_class),
size = 1
) +
scale_fill_manual(values = c(
"-750" = "#2E8B57",
"-700" = "#7FBF7B",
"-650" = "#D1BE91",
"-600" = "#A6764D"
)) +
scale_color_manual(values = c(
"-750" = "#1B5E20",
"-700" = "#4CAF50",
"-650" = "#C2A14D",
"-600" = "#6F3F1F"
)) +
theme_bw()
area_df %>%
filter(!is.na(B1_class)) %>%
ggplot(aes(B0_mid, fill = B1_class)) +
geom_ribbon(aes(ymin = DC_low, ymax = DC_high), alpha = 0.7) +
geom_line(
aes(y = (DC_low + DC_high) / 2, color = B1_class),
size = 1
) +
scale_fill_manual(values = c(
"-750" = "#2E8B57",
"-700" = "#7FBF7B",
"-650" = "#D1BE91",
"-600" = "#A6764D"
)) +
scale_color_manual(values = c(
"-750" = "#1B5E20",
"-700" = "#4CAF50",
"-650" = "#C2A14D",
"-600" = "#6F3F1F"
)) +
theme_bw()

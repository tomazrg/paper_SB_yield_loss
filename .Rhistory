set.seed(123)
sev = seq(0, 9,length.out = 100)
yld = seq(4000, 16000,length.out = 100)
b1 <- runif(100,min = 159.97, max = 430.21)
price_rice <- seq(300, 600,length.out = 10)
combined_data_g1 <- expand.grid(sev = sev, yld = yld, b1 = b1,price_rice = price_rice)
ylmer_simu_g1 = combined_data_g1 %>%
mutate(loss =((((((b1/11142.94)*sev)*100)*yld)/100)/1000)*price_rice)
ylmer_simu_g1$group = "Group 1"
ylmer_simu_g1$b0 = 11142.94
gc()
#sev  = data.frame(sev = seq(20,100, by = 10))
#yield = data.frame(yld = seq(4000,16000,by = 2000))
#combined_data <- expand.grid(sev = sev$sev, yld = yield$yld)
set.seed(123)
sev = seq(0, 9,length.out = 100)
yld = seq(4000, 16000,length.out = 100)
b1 <- runif(100,min = 192.59, max = 376.04)
price_rice <- seq(300, 600,length.out = 10)
combined_data_g2 <- expand.grid(sev = sev, yld = yld, b1 = b1,price_rice = price_rice)
ylmer_simu_g2 = combined_data_g2 %>%
mutate(loss =((((((b1/9945.61)*sev)*100)*yld)/100)/1000)*price_rice)
ylmer_simu_g2$group = "Group 2"
ylmer_simu_g2$b0 = 9945.61
gc()
#sev  = data.frame(sev = seq(20,100, by = 10))
#yield = data.frame(yld = seq(4000,16000,by = 2000))
#combined_data <- expand.grid(sev = sev$sev, yld = yield$yld)
set.seed(123)
sev = seq(0, 9,length.out = 100)
yld = seq(4000, 16000,length.out = 100)
b1 <- runif(100,min = 567.31, max = 796.82)
price_rice <- seq(300, 600,length.out = 10)
combined_data_g3 <- expand.grid(sev = sev, yld = yld, b1 = b1,price_rice = price_rice)
ylmer_simu_g3 = combined_data_g3 %>%
mutate(loss =((((((b1/12368.25)*sev)*100)*yld)/100)/1000)*price_rice)
ylmer_simu_g3$group = "Group 3"
ylmer_simu_g3$b0 = 12368.25
gc()
ylmer_simu_all = rbind(ylmer_simu_g1,ylmer_simu_g2,ylmer_simu_g3)
ylmer_simu_all
heat_loss = ylmer_simu_all %>%
ggplot(aes(sev, yld, fill = loss)) +
geom_raster() +
scale_x_continuous(breaks = seq(0, 9, by = 1),
expand = c(0.02,0.02)) +
scale_y_continuous(breaks = seq(4000, 16000, by = 2000),
expand = c(0.02,0.02)) +
scale_fill_stepsn(
colours = c("#2E8B57",   # dark brown
"#7FBF7B",   # medium brown
"#D1BE91",   # beige transition
"#A6764D",   # light green
"#6F3F1F"),  # dark green
n.breaks = 5,             # number of steps (adjust for contrast)
breaks = seq(0, 3000, 500),
name = "L (USD/ha)",
guide = guide_colorsteps(
keyheight = unit(150, "pt")   # << AQUI aumenta a altura da legenda
)
) +
facet_wrap(~group, ncol =1)+
theme_bw() +
labs(
y = "Attainable yield (kg/ha)",
x = "SB index"
) +
theme(
text = element_text(size = 12),
axis.title = element_text(size = 14, face = "bold"),
strip.text = element_text(size = 14,face = "bold"),
axis.text.x = element_text(vjust = 1),
legend.position = "right",
legend.box = "horizontal",
panel.grid = element_blank(),
strip.background = element_blank()
)
gc()
heat_loss
ylmer_simu_min2 = ylmer_simu_all %>%
group_by(group) %>%
#mutate(loss =((((((b1/b0)*sev)*100)*yld)/100)/1000)) %>%
mutate(loss =((((((b1/b0)*sev)*100)*yld)/100)/1000)*price_rice) %>%
group_by(group) %>%
mutate(pressure = case_when(sev > median(sev) ~ "High pressure",
sev <= median(sev) ~"Low pressure"),
attainable = case_when(yld > median(yld) ~ "High yield",
yld <= median(yld) ~"Low yield"))
simu_summary <- ylmer_simu_min2 %>%
group_by(group,pressure,attainable) %>%
summarise(
mean_loss = mean(loss, na.rm = TRUE),
ci_low = quantile(loss, 0.025),
ci_high = quantile(loss, 0.975),
.groups = "drop"
)
pressure_cols <- c(
"High pressure"  = "#6F3F1F",
"Low pressure" = "#2E8B57")
library(ggplot2)
library(dplyr)
library(scales)
dodge_w <- 0.45   # mantenha o mesmo valor usado nas outras camadas
interval2 <- ylmer_simu_min2 %>%
ggplot(aes(x = pressure, y = loss)) +
# Intervalos (médias + IC) lado a lado por attainable
geom_pointrange(
data = simu_summary,
aes(
x        = pressure,
y        = mean_loss,
ymin     = ci_low,
ymax     = ci_high,
color    = pressure,
linetype = attainable,
group    = attainable
),
position = position_dodge(width = dodge_w),
size = 1.0
) +
# Ponto da média (opcional)
geom_point(
data = simu_summary,
aes(
x     = pressure,
y     = mean_loss,
color = pressure,
shape = attainable,
group = attainable
),
position = position_dodge(width = dodge_w),
size = 2.2
) +
# Texto da média alinhado ao seu respectivo intervalo (lado a lado)
geom_text(
data = simu_summary,
aes(
x     = pressure,
y     = ci_high,  # posiciona o rótulo próximo à ponta superior do IC
# Opção 1 (base R):
label = sprintf("%.2f", mean_loss),
# Opção 2 (scales): label = number(mean_loss, accuracy = 0.01),
color = pressure,
group = attainable
),
position   = position_dodge(width = dodge_w),
nudge_x    = 0.08,    # -> direita (ajuste fino conforme seu espaçamento)
nudge_y    = 0.08,       # pequeno empurrão para não colar na barra
hjust      = -0.1,          # à direita; ajuste conforme preferir
vjust      = 1,       # ligeiramente acima da ponta do intervalo
size       = 4,
fontface   = "bold.italic"
#, check_overlap = TRUE   # opcional para evitar sobreposição
) +
# Escalas
scale_color_manual(values = pressure_cols, name = "Pressure") +
scale_linetype_manual(values = c("Low yield" = "solid", "High yield" = "dashed"),
name = "Attainable") +
scale_shape_manual(values = c("Low yield" = 16, "High yield" = 17),
name = "Attainable") +
facet_wrap(~group, ncol = 1)+
theme_bw() +
labs(
x = "Pressure level",
y = "Economic losses (kg/ha)"
) +
theme(
text = element_text(size = 12),
axis.title = element_text(size = 14, face = "bold"),
strip.text = element_text(size = 14,face = "bold"),
axis.text.x = element_text(vjust = 1),
legend.position = "none",
legend.box = "horizontal",
strip.background = element_blank()
)
interval2
base_plot <- (interval2 | heat_loss) +
plot_layout(guides = "collect")
base_plot
ggsave("fig/ec_losses.png", bg = "white", dpi = 600, height = 6, width = 10)
library(dplyr)
library(tidyr)
set.seed(123)
b0_sim = seq(4000, 16000,length.out = 400)
#b1_sim <- runif(400,min = 567.31, max = 796.82)
#b1_sim <- runif(400,min = 192.59, max = 376.04)
b1_sim <- runif(400,min = 159.97, max = 430.21)
n <- 50000
S_seq <- 0:9
sim_df_g1 <- expand_grid(
S = S_seq,
b0 = b0_sim,
b1 = b1_sim
) %>%
mutate(
Y  = b0 + b1 * S,
Y0 = b0
)
sim_df_g1$group = "Group 1"

u_j <- rnorm(100, mean = 0, sd = 1467)
b1 <- runif(100,min = 159.9782, max = 430.2115)
b0 = runif(100,min =  6680.5477,max = 15566.8496)
df_r1 <- expand.grid(sev = seq(0, 100, by = 1), rep = 1:100)
df_r1$yield = b0 - b1*df_r1$sev - rep(u_j, each = 101)
df_r1$relative <- df_r1$yield *100 / b0
par_r1 = as.data.frame(b0)
par_r1$b1 = b1
par_r1$u_j = u_j
par_r1$group = "Group 1"
summary(model_r1)
confint(model_r3)
